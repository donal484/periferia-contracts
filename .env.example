# Proveedor del modelo: gemini | openai | anthropic (si se omite, usa el primero que tenga clave)
LLM_PROVIDER=gemini

# Google Gemini (tiene capa gratuita: clave en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Modelos de respaldo, separados por coma: se usan si el principal sigue saturado tras los reintentos
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite

# OpenAI (o cualquier API compatible cambiando OPENAI_BASE_URL)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Límites de costo y robustez
LLM_TIMEOUT_MS=60000
MAX_AGENT_ITERATIONS=25
MAX_SESSION_TOKENS=300000

# Opcional: si se define, la API del link público exige esta clave (encabezado x-access-key)
ACCESS_KEY=

PORT=3000
